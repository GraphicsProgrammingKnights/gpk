# Copy to .env.local for `npm run dev`, or to .env for `docker compose up`.
# Never commit real values; .gitignore keeps .env and .env.local out of git.

# Stripe secret key (test mode: sk_test_..., live: sk_live_...). Server only.
STRIPE_SECRET_KEY=

# Stripe Price ID for the current membership term.
# One Product per term in the Dashboard, e.g. "GPK Membership - 2026-27".
STRIPE_PRICE_ID=

# Public origin used to build Stripe's success/cancel URLs, e.g. https://gpknights.org (no trailing slash).
# Leave empty locally: the checkout route falls back to the request's origin. Set it in production.
NEXT_PUBLIC_SITE_URL=
